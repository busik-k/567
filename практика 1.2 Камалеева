#include <stdio.h>

int main() {
    int number;
    
    printf("Введите целое число: ");
    scanf("%d", &number);
    
    // Используем остаток от деления и строковые литералы для вывода результата
    printf("Число %d - %s\n", number, (number % 2 == 0) ? "четное" : "нечетное");
    
    return 0;
}
