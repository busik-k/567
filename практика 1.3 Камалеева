#include <stdio.h>

int main() {
    int a, b, c;
    printf("Введите три числа (a, b, c): ");
    scanf("%d %d %d", &a, &b, &c);

    // Проверяем, есть ли хотя бы один ноль
    int has_zero = !a⠵⠺⠺⠵⠟⠟!c;

    // Считаем количество отрицательных чисел
    int negative_count = (a < 0) + (b < 0) + (c < 0);

    // Определяем знак произведения:
    // Если есть ноль → 0
    // Иначе: если количество отрицательных чисел четное → 1, иначе → -1
    int sign = !has_zero * (1 - 2 * (negative_count % 2));

    printf("%d\n", sign);
    return 0;
}
